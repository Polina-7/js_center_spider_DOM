"use strict";
window.addEventListener("load", function() {
    var field = document.querySelector(".wall");
    var spider = document.querySelector(".spider");
    if (field && spider) {
        var fieldWidth = field.clientWidth;
        var fieldHeight = field.clientHeight;
        var spiderWidth = spider.clientWidth;
        var spiderHeight = spider.clientHeight;
        var centerX = (fieldWidth - spiderWidth) / 2;
        var centerY = (fieldHeight - spiderHeight) / 2;
        spider.style.position = "absolute";
        spider.style.left = "".concat(centerX, "px");
        spider.style.top = "".concat(centerY, "px");
    }
});

